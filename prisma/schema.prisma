generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  employee
  manager
  hr
  exco
}

enum EmploymentStatus {
  active
  on_leave
  probation
  terminated
}

enum EmploymentType {
  full_time
  part_time
  contract
}

enum PayFrequency {
  monthly
  biweekly
  weekly
}

enum LeaveType {
  annual
  sick
  unpaid
  family
  maternity
  parental
  adoption
  commissioning
  study
}

enum LeaveStatus {
  pending
  approved
  rejected
  cancelled
}

enum PayrollRunStatus {
  scheduled
  processing
  awaiting_approval
  completed
}

enum PayslipTemplate {
  classic
  modern
  corporate
  branded
}

enum PayslipLogoAlignment {
  left
  center
  right
}

enum ActivityType {
  hire
  leave_request
  leave_approved
  leave_rejected
  leave_cancelled
  payroll_run
  promotion
  document
  termination
  onboarding
  settings_updated
}

enum NotificationType {
  info
  success
  warning
}

// ============================================================
// PAYROLL COMPLIANCE ENUMS
// ============================================================

enum TenantPlan {
  trial
  hr
  hr_payroll
}

enum PayrollProfileStatus {
  active
  inactive
}

enum EarningCategory {
  basic_salary
  overtime
  bonus
  commission
  travel_allowance
  housing_allowance
  other_allowance
}

enum DeductionCategory {
  paye
  uif
  medical_aid
  retirement_fund
  garnishee
  loan_repayment
  other
}

enum ComplianceType {
  paye_return
  uif_return
  sdl_return
  emp201
  emp501
}

enum ComplianceStatus {
  pending
  submitted
  accepted
  rejected
}

enum BankExportStatus {
  pending
  approved
  exported
  cancelled
}

enum InviteStatus {
  pending
  accepted
  revoked
}

model Tenant {
  id                 String       @id @default(cuid())
  name               String
  legalName          String
  initials           String
  industry           String
  color              String
  founded            String
  currency           String       @default("ZAR")
  payFrequency       PayFrequency @default(monthly)
  registrationNumber String
  vatNumber          String
  address            String
  city               String
  payDay             Int          @default(25)
  bankName           String
  primaryContact     String
  plan               TenantPlan   @default(trial)
  trialEndsAt        DateTime?
  payrollDisclaimerAcceptedAt DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  users              User[]
  employees          Employee[]
  departments        Department[]
  leaveRequests      LeaveRequest[]
  payrollRuns        PayrollRun[]
  payslips           Payslip[]
  activity           ActivityItem[]
  notifications      NotificationItem[]

  // Payroll compliance relations
  payrollProfiles    PayrollProfile[]
  payrollSettings    PayrollSettings?
  earningTypes       EarningType[]
  deductionTypes     DeductionType[]
  employeeDocuments  EmployeeDocument[]
  employeeDeductions EmployeeDeduction[]
  etiClaims          EtiClaim[]
  complianceRecords  ComplianceRecord[]
  bankExports        BankExport[]
  payrollItems       PayrollItem[]
  salaryHistory      EmployeeSalaryHistory[]
  invites            Invite[]
  employeeNumberConfig  EmployeeNumberConfig?
  leavePolicy           TenantLeavePolicy?
  customHolidays        CustomHoliday[]
  leaveReviewers        LeaveReviewer[]
}

model User {
  id                      String    @id // Supabase auth.users.id
  tenantId                String
  tenant                  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email                   String    @unique
  name                    String
  title                   String
  role                    UserRole  @default(hr)
  employeeId              String?   @unique
  employee                Employee? @relation(fields: [employeeId], references: [id])
  avatarColor             String
  initials                String
  notificationPreferences Json?
  createdAt               DateTime  @default(now())

  @@index([tenantId])
}

model Employee {
  id             String           @id @default(cuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeNumber String
  firstName      String
  lastName       String
  preferredName  String?
  email          String
  phone          String
  avatarColor    String
  initials       String
  photoUrl       String?
  jobTitle       String
  department     String
  employmentType EmploymentType
  status         EmploymentStatus @default(active)
  startDate      DateTime
  location       String
  managerId      String?

  salaryAnnualGross            Decimal @db.Decimal(15, 2)
  salaryCurrency                String       @default("ZAR")
  salaryPayFrequency             PayFrequency @default(monthly)
  salaryTravelAllowance           Decimal? @db.Decimal(15, 2)
  salaryHousingAllowance           Decimal? @db.Decimal(15, 2)
  salaryPensionContributionPct     Float?
  salaryMedicalAid                  Decimal? @db.Decimal(15, 2)
  salaryRetirementAnnuity          Decimal? @db.Decimal(15, 2)

  bankName              String
  bankAccountNumber     String
  bankBranchCode        String
  bankAccountType       String
  bankAccountValidated  Boolean   @default(false)
  bankValidatedAt       DateTime?

  taxNumber String
  idNumber  String
  address   String

  emergencyContactName         String
  emergencyContactRelationship String
  emergencyContactPhone        String

  // Employment Equity (EEA2/EEA4) demographics
  equityRace        EquityRace?
  equityGender      EquityGender?
  occupationalLevel OccupationalLevel?
  foreignNational   Boolean            @default(false)
  hasDisability     Boolean            @default(false)

  onboarding Json?

  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  payslips      Payslip[]
  user          User?

  // Payroll compliance relations
  payrollProfile PayrollProfile?
  salaryHistory  EmployeeSalaryHistory[]
  payrollItems   PayrollItem[]
  documents      EmployeeDocument[]
  deductions     EmployeeDeduction[]
  etiClaims      EtiClaim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model LeaveBalance {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       LeaveType
  total      Float
  used       Float     @default(0)

  @@unique([employeeId, type])
}

model LeaveRequest {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type          LeaveType
  startDate     DateTime
  endDate       DateTime
  days          Float
  /// JSON array of { date: string (ISO), type: "full" | "partial" }.
  /// Null for requests created before the day-picker feature.
  daySelections Json?
  reason        String
  documentUrl   String?
  status        LeaveStatus @default(pending)
  appliedOn     DateTime    @default(now())
  decisionNote  String?
  decidedBy     String?
  decidedOn     DateTime?
  cancelledBy   String?
  cancelledOn   DateTime?

  @@index([tenantId])
  @@index([employeeId])
}

model Department {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String
  headId      String?
  color       String
  budget      Decimal @db.Decimal(15, 2)

  @@index([tenantId])
}

model PayrollRun {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period          String
  label           String
  payDate         DateTime
  status          PayrollRunStatus @default(scheduled)
  totalGross      Decimal @db.Decimal(15, 2)            @default(0)
  totalDeductions Decimal @db.Decimal(15, 2)            @default(0)
  totalNet        Decimal @db.Decimal(15, 2)            @default(0)
  totalPaye       Decimal @db.Decimal(15, 2)            @default(0)
  totalUif        Decimal @db.Decimal(15, 2)            @default(0)
  employeeCount   Int              @default(0)
  processedOn     DateTime?

  payslips     Payslip[]
  bankExports  BankExport[]
  approvedBy   String?
  approvedAt   DateTime?
  approvalNote String?

  @@index([tenantId])
}

model Payslip {
  id              String     @id @default(cuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runId           String
  run             PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period          String
  payDate         DateTime
  basicSalary     Decimal @db.Decimal(15, 2)
  earnings        Json
  deductions      Json
  grossPay        Decimal @db.Decimal(15, 2)
  totalDeductions Decimal @db.Decimal(15, 2)
  netPay          Decimal @db.Decimal(15, 2)
  paye            Decimal @db.Decimal(15, 2)
  uif             Decimal @db.Decimal(15, 2)
  payrollItems    PayrollItem[]

  @@index([tenantId])
  @@index([employeeId])
}

model ActivityItem {
  id         String       @id @default(cuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type       ActivityType
  message    String
  actor      String
  employeeId String?
  timestamp  DateTime     @default(now())

  @@index([tenantId])
}

model NotificationItem {
  id                  String           @id @default(cuid())
  tenantId            String
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title               String
  description         String
  timestamp           DateTime         @default(now())
  read                Boolean          @default(false)
  type                NotificationType
  // Audience scoping. Only one of these should be set per notification.
  // audienceRole: "hr" = hr+exco only; "manager" = hr+exco+manager; null = broadcast (use sparingly)
  // recipientEmployeeId: personal notification for exactly one employee (takes precedence)
  audienceRole        String?
  recipientEmployeeId String?

  @@index([tenantId])
  @@index([tenantId, recipientEmployeeId])
}

// ============================================================
// PAYROLL COMPLIANCE MODELS
// ============================================================

model PayrollProfile {
  id                   String               @id @default(cuid())
  tenantId             String
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId           String               @unique
  employee             Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  status               PayrollProfileStatus @default(active)
  taxNumber            String?
  uifNumber            String?
  taxDirective         String?
  taxDirectiveAmount   Decimal? @db.Decimal(15, 2)
  payFrequency         PayFrequency         @default(monthly)
  effectiveDate        DateTime             @default(now())
  medicalAidScheme     String?
  medicalAidNumber     String?
  medicalAidDependants Int                  @default(0)
  retirementFundName   String?
  retirementFundNumber String?
  notes                String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([tenantId])
}

model EarningType {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  category    EarningCategory
  isTaxable   Boolean         @default(true)
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([tenantId])
}

model DeductionType {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  category    DeductionCategory
  isEmployer  Boolean           @default(false)
  isStatutory Boolean           @default(false)
  isActive    Boolean           @default(true)
  sortOrder   Int               @default(0)
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([tenantId])
}

model ComplianceRecord {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period      String
  type        ComplianceType
  status      ComplianceStatus @default(pending)
  totalPaye   Decimal @db.Decimal(15, 2)            @default(0)
  totalUif    Decimal @db.Decimal(15, 2)            @default(0)
  totalSdl    Decimal @db.Decimal(15, 2)            @default(0)
  totalEti    Decimal @db.Decimal(15, 2)            @default(0)
  etiCarriedForward Decimal @db.Decimal(15, 2)       @default(0)
  totalAmount Decimal @db.Decimal(15, 2)            @default(0)
  dueDate     DateTime?
  submittedOn DateTime?
  reference   String?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([tenantId, period, type])
  @@index([tenantId])
}

/// CAUTION: a raw-SQL partial unique index (BankExport_active_nif_per_run_key,
/// one active nif export per payroll run) exists in 20260709120000_baseline_v1
/// but cannot be expressed here. Do not let `migrate dev` drop it.
model BankExport {
  id           String           @id @default(cuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollRunId String
  payrollRun   PayrollRun       @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  status       BankExportStatus @default(pending)
  totalAmount  Decimal @db.Decimal(15, 2)
  paymentCount Int
  bankName     String?
  fileFormat   String           @default("csv")
  exportedAt   DateTime?
  approvedBy   String?
  approvedAt   DateTime?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([tenantId])
}

model PayrollSettings {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taxYearStart       String   @default("03")
  taxYearEnd         String   @default("02")
  sdlEnabled         Boolean  @default(true)
  sdlRate            Float    @default(0.01)
  uifEnabled         Boolean  @default(true)
  uifEmployeeRate    Float    @default(0.01)
  uifEmployerRate    Float    @default(0.01)
  uifCeiling         Decimal @db.Decimal(15, 2)    @default(17712)
  offersPension      Boolean  @default(false)
  offersMedicalAid   Boolean  @default(false)
  payrollConfiguredAt DateTime?
  payslipCompanyName String?
  payslipLogoUrl     String?
  payslipAccentColor String          @default("#6366f1")
  payslipTemplate    PayslipTemplate @default(classic)
  payslipLogoAlignment PayslipLogoAlignment @default(left)
  payslipFooterNote  String?
  payslipShowBanking Boolean         @default(false)
  payslipShowYtd     Boolean         @default(true)
  requireApproval      Boolean  @default(false)
  approvalUserId       String?
  netcashSalaryKey          String?
  netcashAccountServicesKey String?
  netcashInstruction        String   @default("DatedSalaries")
  netcashEnvironment        String   @default("production")
  payeReferenceNumber  String?
  uifReferenceNumber   String?
  sdlReferenceNumber   String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model PayrollItem {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payslipId   String
  payslip     Payslip  @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  itemType    String
  category    String
  label       String
  isStatutory Boolean  @default(false)
  isEmployer  Boolean  @default(false)
  amount      Decimal @db.Decimal(15, 2)
  ytdAmount   Decimal @db.Decimal(15, 2)    @default(0)
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([payslipId])
  @@index([employeeId])
}

model Invite {
  id         String       @id @default(cuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email      String
  name       String
  role       UserRole     @default(employee)
  employeeId String?
  // SHA-256 hash of the invite token. The raw token only ever appears in the
  // invite email link and is never stored.
  tokenHash  String       @unique
  status     InviteStatus @default(pending)
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([tenantId])
}

model EmployeeSalaryHistory {
  id                String       @id @default(cuid())
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  annualGross       Decimal @db.Decimal(15, 2)
  payFrequency      PayFrequency
  travelAllowance   Decimal? @db.Decimal(15, 2)
  housingAllowance  Decimal? @db.Decimal(15, 2)
  medicalAid        Decimal? @db.Decimal(15, 2)
  pensionContribPct Float?
  retirementAnnuity Decimal? @db.Decimal(15, 2)
  effectiveDate     DateTime
  changedBy         String
  changeReason      String?
  createdAt         DateTime     @default(now())

  @@index([tenantId])
  @@index([employeeId])
}

model EmployeeNumberConfig {
  id         String   @id @default(cuid())
  tenantId   String   @unique
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prefix     String   @default("EMP")
  padLength  Int      @default(4)
  separator  String   @default("-")
  nextNumber Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TenantLeavePolicy {
  id                      String   @id @default(cuid())
  tenantId                String   @unique
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  annualDays              Float    @default(15)
  sickDays                Float    @default(30)
  familyDays              Float    @default(3)
  maternityDays           Float    @default(88)
  parentalDays            Float    @default(10)
  adoptionDays            Float    @default(50)
  commissioningDays       Float    @default(50)
  studyDays               Float    @default(5)
  unpaidDays              Float    @default(5)
  annualCarryover         Boolean  @default(false)
  annualMaxCarryoverDays  Float    @default(5)
  sickRequireDocDays      Int      @default(2)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

enum EmployeeDocumentCategory {
  contract
  id_document
  qualification
  certificate
  disciplinary
  medical
  other
}

model EmployeeDocument {
  id          String                   @id @default(cuid())
  tenantId    String
  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name        String
  category    EmployeeDocumentCategory @default(other)
  storagePath String
  fileName    String
  mimeType    String
  sizeBytes   Int                      @default(0)
  expiresAt   DateTime?
  uploadedBy  String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([tenantId])
  @@index([employeeId])
}

enum DeductionKind {
  loan
  garnishee
  other
}

enum RecoveryStatus {
  active
  settled
  cancelled
}

model EmployeeDeduction {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind           DeductionKind  @default(loan)
  description    String
  reference      String?
  originalAmount Decimal @db.Decimal(15, 2)
  monthlyAmount  Decimal @db.Decimal(15, 2)
  balance        Decimal @db.Decimal(15, 2)
  status         RecoveryStatus @default(active)
  startDate      DateTime       @default(now())
  settledAt      DateTime?
  createdBy      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([tenantId])
  @@index([employeeId])
}

enum EquityRace {
  african
  coloured
  indian
  white
  other
}

enum EquityGender {
  male
  female
  other
}

enum OccupationalLevel {
  top_management
  senior_management
  professional_mid
  skilled_technical
  semi_skilled
  unskilled
}

model CustomHoliday {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  date      String  // YYYY-MM-DD
  recurring Boolean @default(false)

  @@index([tenantId])
}

// Configures who can approve leave requests, beyond the default HR/manager roles.
// HR admin sets this up; any matching reviewer can approve/reject.
// scope: "all" = whole tenant, "department" = one department, "employee" = one employee.
model LeaveReviewer {
  id                 String  @id @default(cuid())
  tenantId           String
  tenant             Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviewerEmployeeId String  // employee who is authorised to approve leave
  scope              String  @default("all") // "all" | "department" | "employee"
  scopeId            String? // departmentId or employeeId when scope != "all"
  label              String? // optional display label, e.g. "Engineering backup approver"

  @@index([tenantId])
  @@index([tenantId, reviewerEmployeeId])
}

model EtiClaim {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period          String
  qualifyingMonth Int
  amount          Decimal @db.Decimal(15, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([employeeId, period])
  @@index([tenantId])
  @@index([employeeId])
}
