generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  employee
  manager
  hr
  exco
}

enum EmploymentStatus {
  active
  on_leave
  probation
  terminated
}

enum EmploymentType {
  full_time
  part_time
  contract
}

enum PayFrequency {
  monthly
  biweekly
  weekly
}

enum LeaveType {
  annual
  sick
  unpaid
  family
  maternity
  parental
  adoption
  commissioning
  study
}

enum LeaveStatus {
  pending
  approved
  rejected
}

enum PayrollRunStatus {
  scheduled
  processing
  awaiting_approval
  completed
}

enum PayslipTemplate {
  classic
  modern
  corporate
  branded
}

enum ActivityType {
  hire
  leave_request
  leave_approved
  leave_rejected
  payroll_run
  promotion
  document
  termination
  onboarding
  settings_updated
}

enum NotificationType {
  info
  success
  warning
}

// ============================================================
// PAYROLL COMPLIANCE ENUMS
// ============================================================

enum TenantPlan {
  trial
  hr
  hr_payroll
}

enum PayrollProfileStatus {
  active
  inactive
}

enum EarningCategory {
  basic_salary
  overtime
  bonus
  commission
  travel_allowance
  housing_allowance
  other_allowance
}

enum DeductionCategory {
  paye
  uif
  medical_aid
  retirement_fund
  garnishee
  loan_repayment
  other
}

enum ComplianceType {
  paye_return
  uif_return
  sdl_return
  emp201
  emp501
}

enum ComplianceStatus {
  pending
  submitted
  accepted
  rejected
}

enum BankExportStatus {
  pending
  approved
  exported
  cancelled
}

enum InviteStatus {
  pending
  accepted
  revoked
}

model Tenant {
  id                 String       @id @default(cuid())
  name               String
  legalName          String
  initials           String
  industry           String
  color              String
  founded            String
  currency           String       @default("ZAR")
  payFrequency       PayFrequency @default(monthly)
  registrationNumber String
  vatNumber          String
  address            String
  city               String
  payDay             Int          @default(25)
  bankName           String
  primaryContact     String
  plan               TenantPlan   @default(trial)
  trialEndsAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  users              User[]
  employees          Employee[]
  departments        Department[]
  leaveRequests      LeaveRequest[]
  payrollRuns        PayrollRun[]
  payslips           Payslip[]
  activity           ActivityItem[]
  notifications      NotificationItem[]

  // Payroll compliance relations
  payrollProfiles    PayrollProfile[]
  payrollSettings    PayrollSettings?
  earningTypes       EarningType[]
  deductionTypes     DeductionType[]
  employeeDocuments  EmployeeDocument[]
  complianceRecords  ComplianceRecord[]
  bankExports        BankExport[]
  payrollItems       PayrollItem[]
  salaryHistory      EmployeeSalaryHistory[]
  invites            Invite[]
  employeeNumberConfig  EmployeeNumberConfig?
  leavePolicy           TenantLeavePolicy?
}

model User {
  id                      String    @id // Supabase auth.users.id
  tenantId                String
  tenant                  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email                   String    @unique
  name                    String
  title                   String
  role                    UserRole  @default(hr)
  employeeId              String?   @unique
  employee                Employee? @relation(fields: [employeeId], references: [id])
  avatarColor             String
  initials                String
  notificationPreferences Json?
  createdAt               DateTime  @default(now())

  @@index([tenantId])
}

model Employee {
  id             String           @id @default(cuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeNumber String
  firstName      String
  lastName       String
  preferredName  String?
  email          String
  phone          String
  avatarColor    String
  initials       String
  photoUrl       String?
  jobTitle       String
  department     String
  employmentType EmploymentType
  status         EmploymentStatus @default(active)
  startDate      DateTime
  location       String
  managerId      String?

  salaryAnnualGross            Float
  salaryCurrency                String       @default("ZAR")
  salaryPayFrequency             PayFrequency @default(monthly)
  salaryTravelAllowance           Float?
  salaryHousingAllowance           Float?
  salaryPensionContributionPct     Float?
  salaryMedicalAid                  Float?

  bankName              String
  bankAccountNumber     String
  bankBranchCode        String
  bankAccountType       String
  bankAccountValidated  Boolean   @default(false)
  bankValidatedAt       DateTime?

  taxNumber String
  idNumber  String
  address   String

  emergencyContactName         String
  emergencyContactRelationship String
  emergencyContactPhone        String

  onboarding Json?

  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  payslips      Payslip[]
  user          User?

  // Payroll compliance relations
  payrollProfile PayrollProfile?
  salaryHistory  EmployeeSalaryHistory[]
  payrollItems   PayrollItem[]
  documents      EmployeeDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model LeaveBalance {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       LeaveType
  total      Float
  used       Float     @default(0)

  @@unique([employeeId, type])
}

model LeaveRequest {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         LeaveType
  startDate    DateTime
  endDate      DateTime
  days         Float
  reason       String
  documentUrl  String?
  status       LeaveStatus @default(pending)
  appliedOn    DateTime    @default(now())
  decisionNote String?
  decidedBy    String?
  decidedOn    DateTime?

  @@index([tenantId])
  @@index([employeeId])
}

model Department {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String
  headId      String?
  color       String
  budget      Float

  @@index([tenantId])
}

model PayrollRun {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period          String
  label           String
  payDate         DateTime
  status          PayrollRunStatus @default(scheduled)
  totalGross      Float            @default(0)
  totalDeductions Float            @default(0)
  totalNet        Float            @default(0)
  totalPaye       Float            @default(0)
  totalUif        Float            @default(0)
  employeeCount   Int              @default(0)
  processedOn     DateTime?

  payslips     Payslip[]
  bankExports  BankExport[]
  approvedBy   String?
  approvedAt   DateTime?
  approvalNote String?

  @@index([tenantId])
}

model Payslip {
  id              String     @id @default(cuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runId           String
  run             PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period          String
  payDate         DateTime
  basicSalary     Float
  earnings        Json
  deductions      Json
  grossPay        Float
  totalDeductions Float
  netPay          Float
  paye            Float
  uif             Float
  payrollItems    PayrollItem[]

  @@index([tenantId])
  @@index([employeeId])
}

model ActivityItem {
  id         String       @id @default(cuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type       ActivityType
  message    String
  actor      String
  employeeId String?
  timestamp  DateTime     @default(now())

  @@index([tenantId])
}

model NotificationItem {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String
  timestamp   DateTime         @default(now())
  read        Boolean          @default(false)
  type        NotificationType

  @@index([tenantId])
}

// ============================================================
// PAYROLL COMPLIANCE MODELS
// ============================================================

model PayrollProfile {
  id                   String               @id @default(cuid())
  tenantId             String
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId           String               @unique
  employee             Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  status               PayrollProfileStatus @default(active)
  taxNumber            String?
  uifNumber            String?
  taxDirective         String?
  taxDirectiveAmount   Float?
  payFrequency         PayFrequency         @default(monthly)
  effectiveDate        DateTime             @default(now())
  medicalAidScheme     String?
  medicalAidNumber     String?
  medicalAidDependants Int                  @default(0)
  retirementFundName   String?
  retirementFundNumber String?
  notes                String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([tenantId])
}

model EarningType {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  category    EarningCategory
  isTaxable   Boolean         @default(true)
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([tenantId])
}

model DeductionType {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  category    DeductionCategory
  isEmployer  Boolean           @default(false)
  isStatutory Boolean           @default(false)
  isActive    Boolean           @default(true)
  sortOrder   Int               @default(0)
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([tenantId])
}

model ComplianceRecord {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period      String
  type        ComplianceType
  status      ComplianceStatus @default(pending)
  totalPaye   Float            @default(0)
  totalUif    Float            @default(0)
  totalSdl    Float            @default(0)
  totalEti    Float            @default(0)
  etiCarriedForward Float       @default(0)
  totalAmount Float            @default(0)
  dueDate     DateTime?
  submittedOn DateTime?
  reference   String?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([tenantId, period, type])
  @@index([tenantId])
}

model BankExport {
  id           String           @id @default(cuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollRunId String
  payrollRun   PayrollRun       @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  status       BankExportStatus @default(pending)
  totalAmount  Float
  paymentCount Int
  bankName     String?
  fileFormat   String           @default("csv")
  exportedAt   DateTime?
  approvedBy   String?
  approvedAt   DateTime?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([tenantId])
}

model PayrollSettings {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taxYearStart       String   @default("03")
  taxYearEnd         String   @default("02")
  sdlEnabled         Boolean  @default(true)
  sdlRate            Float    @default(0.01)
  uifEnabled         Boolean  @default(true)
  uifEmployeeRate    Float    @default(0.01)
  uifEmployerRate    Float    @default(0.01)
  uifCeiling         Float    @default(17712)
  payslipCompanyName String?
  payslipLogoUrl     String?
  payslipAccentColor String          @default("#6366f1")
  payslipTemplate    PayslipTemplate @default(classic)
  payslipFooterNote  String?
  payslipShowBanking Boolean         @default(false)
  payslipShowYtd     Boolean         @default(true)
  requireApproval      Boolean  @default(false)
  approvalUserId       String?
  netcashSalaryKey          String?
  netcashAccountServicesKey String?
  netcashInstruction        String   @default("DatedSalaries")
  netcashEnvironment        String   @default("production")
  payeReferenceNumber  String?
  uifReferenceNumber   String?
  sdlReferenceNumber   String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model PayrollItem {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payslipId   String
  payslip     Payslip  @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  itemType    String
  category    String
  label       String
  isStatutory Boolean  @default(false)
  isEmployer  Boolean  @default(false)
  amount      Float
  ytdAmount   Float    @default(0)
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([payslipId])
  @@index([employeeId])
}

model Invite {
  id         String       @id @default(cuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email      String
  name       String
  role       UserRole     @default(employee)
  employeeId String?
  // SHA-256 hash of the invite token. The raw token only ever appears in the
  // invite email link and is never stored.
  tokenHash  String       @unique
  status     InviteStatus @default(pending)
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([tenantId])
}

model EmployeeSalaryHistory {
  id                String       @id @default(cuid())
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  annualGross       Float
  payFrequency      PayFrequency
  travelAllowance   Float?
  housingAllowance  Float?
  medicalAid        Float?
  pensionContribPct Float?
  effectiveDate     DateTime
  changedBy         String
  changeReason      String?
  createdAt         DateTime     @default(now())

  @@index([tenantId])
  @@index([employeeId])
}

model EmployeeNumberConfig {
  id         String   @id @default(cuid())
  tenantId   String   @unique
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prefix     String   @default("EMP")
  padLength  Int      @default(4)
  separator  String   @default("-")
  nextNumber Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TenantLeavePolicy {
  id                      String   @id @default(cuid())
  tenantId                String   @unique
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  annualDays              Float    @default(15)
  sickDays                Float    @default(30)
  familyDays              Float    @default(3)
  maternityDays           Float    @default(88)
  parentalDays            Float    @default(10)
  adoptionDays            Float    @default(50)
  commissioningDays       Float    @default(50)
  studyDays               Float    @default(5)
  unpaidDays              Float    @default(5)
  annualCarryover         Boolean  @default(true)
  annualMaxCarryoverDays  Float    @default(10)
  sickRequireDocDays      Int      @default(2)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

enum EmployeeDocumentCategory {
  contract
  id_document
  qualification
  certificate
  disciplinary
  medical
  other
}

model EmployeeDocument {
  id          String                   @id @default(cuid())
  tenantId    String
  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name        String
  category    EmployeeDocumentCategory @default(other)
  storagePath String
  fileName    String
  mimeType    String
  sizeBytes   Int                      @default(0)
  expiresAt   DateTime?
  uploadedBy  String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([tenantId])
  @@index([employeeId])
}
