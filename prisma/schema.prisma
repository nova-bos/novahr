generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  employee
  manager
  hr
  exco
}

enum EmploymentStatus {
  active
  on_leave
  probation
  terminated
}

enum EmploymentType {
  full_time
  part_time
  contract
  temporary
  casual
  learnership
  internship
}

enum PayFrequency {
  monthly
  biweekly
  weekly
}

enum LeaveType {
  annual
  sick
  unpaid
  family
  maternity
  parental
  adoption
  commissioning
  study
}

enum LeaveStatus {
  pending
  approved
  rejected
  cancelled
}

enum PayrollRunStatus {
  scheduled
  processing
  awaiting_approval
  completed
}

enum PayslipTemplate {
  classic
  modern
  corporate
  branded
}

enum PayslipLogoAlignment {
  left
  center
  right
}

enum ActivityType {
  hire
  leave_request
  leave_approved
  leave_rejected
  leave_cancelled
  payroll_run
  promotion
  document
  termination
  onboarding
  settings_updated
}

enum NotificationType {
  info
  success
  warning
}

// ============================================================
// PAYROLL COMPLIANCE ENUMS
// ============================================================

enum TenantPlan {
  trial
  subscribed
  enterprise
}

enum PayrollProfileStatus {
  active
  inactive
}

enum EarningCategory {
  basic_salary
  overtime
  bonus
  commission
  travel_allowance
  housing_allowance
  other_allowance
}

enum DeductionCategory {
  paye
  uif
  medical_aid
  retirement_fund
  garnishee
  loan_repayment
  other
}

enum ComplianceType {
  paye_return
  uif_return
  sdl_return
  emp201
  emp501
}

enum ComplianceStatus {
  pending
  submitted
  accepted
  rejected
}

enum BankExportStatus {
  pending
  approved
  exported
  cancelled
}

enum InviteStatus {
  pending
  accepted
  revoked
}

model Tenant {
  id                 String       @id @default(cuid())
  name               String
  legalName          String
  initials           String
  industry           String
  color              String
  founded            String
  currency           String       @default("ZAR")
  payFrequency       PayFrequency @default(monthly)
  registrationNumber String
  vatNumber          String
  address            String
  city               String
  payDay             Int          @default(25)
  bankName           String
  primaryContact     String
  plan               TenantPlan   @default(trial)
  trialEndsAt        DateTime?
  payrollDisclaimerAcceptedAt DateTime?
  // Paystack billing fields
  paystackCustomerCode     String?
  paystackSubscriptionCode String?
  paystackAuthCode         String?   // authorization_code for recurring charges
  paystackBillingEmail     String?   // email used in the original Paystack transaction
  subscriptionStatus       String?   // active, past_due, canceled, incomplete
  currentPeriodEnd         DateTime?
  billingMemberCount       Int?      // active member count at last billing snapshot
  billingAmountKobo        Int?      // amount charged at last billing (in kobo)
  // When true, active employees with a dateOfBirth set appear on the company
  // calendar with their birthday (day + month only, never the year). Default
  // off so tenants that do not want this are unaffected.
  showBirthdaysOnCalendar  Boolean  @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  users              User[]
  employees          Employee[]
  departments        Department[]
  leaveRequests      LeaveRequest[]
  payrollRuns        PayrollRun[]
  payslips           Payslip[]
  activity           ActivityItem[]
  notifications      NotificationItem[]

  // Payroll compliance relations
  payrollProfiles    PayrollProfile[]
  payrollSettings    PayrollSettings?
  earningTypes       EarningType[]
  deductionTypes     DeductionType[]
  employeeDocuments  EmployeeDocument[]
  employeeDeductions EmployeeDeduction[]
  etiClaims          EtiClaim[]
  complianceRecords  ComplianceRecord[]
  bankExports        BankExport[]
  payrollItems       PayrollItem[]
  payrollInputs      PayrollInput[]
  salaryHistory      EmployeeSalaryHistory[]
  invites            Invite[]
  employeeNumberConfig  EmployeeNumberConfig?
  leavePolicy           TenantLeavePolicy?
  customHolidays        CustomHoliday[]
  leaveReviewers        LeaveReviewer[]
  billingCharges        BillingCharge[]
  employeeQualifications EmployeeQualification[]
  customFieldDefinitions TenantCustomFieldDefinition[]
  customFieldValues      EmployeeCustomFieldValue[]
  branches               Branch[]
  disciplinaryRecords    DisciplinaryRecord[]
  announcements          Announcement[]
  performanceReviews     PerformanceReview[]
  historyEvents          EmployeeHistoryEvent[]
  jobPositions           JobPosition[]
  costCentres            CostCentre[]
}

// A physical or organisational branch (site, office, region) within a tenant.
// Additive and optional: a tenant with zero branches behaves exactly as before.
// A null branchId on an Employee or PayrollRun means "whole company / head
// office". Only Tenant carries a back-relation; Employee, PayrollRun and User
// hold plain scalar branch columns (no back-relation) so their existing
// checked-update paths are unaffected.
model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  address   String?
  city      String?
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model BillingCharge {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reference        String   @unique
  period           String   // YYYY-MM
  amountKobo       Int
  status           String   // success | failed
  chargeType       String   // subscription_init | subscription_renewal
  paystackChargeId String?
  createdAt        DateTime @default(now())

  @@unique([tenantId, period])
  @@index([tenantId])
}

model User {
  id                      String    @id // Supabase auth.users.id
  tenantId                String
  tenant                  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email                   String    @unique
  name                    String
  title                   String
  role                    UserRole  @default(hr)
  employeeId              String?   @unique
  employee                Employee? @relation(fields: [employeeId], references: [id])
  avatarColor             String
  initials                String
  notificationPreferences Json?
  // Branch scope for admins. Null means the user sees and acts on the whole
  // company (current behaviour). When set, HR limits this admin to a single
  // branch: the employee directory and payroll eligibility are additionally
  // filtered to this branch, inside the existing tenant boundary.
  branchScopeId           String?
  createdAt               DateTime  @default(now())

  @@index([tenantId])
}

model Employee {
  id             String           @id @default(cuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeNumber String
  firstName      String
  lastName       String
  preferredName  String?
  email          String
  phone          String
  avatarColor    String
  initials       String
  photoUrl       String?
  jobTitle       String
  department     String
  employmentType EmploymentType
  status         EmploymentStatus @default(active)
  startDate      DateTime
  // Optional probation end date. Drives the "confirm or extend" reminder while
  // status is probation. Null means no probation tracked.
  probationEndDate DateTime?
  location       String
  managerId      String?
  // Optional branch assignment. Null means "whole company / head office"
  // (current behaviour). Plain scalar (no Prisma relation) so the existing
  // checked employee-update path is unaffected.
  branchId       String?
  // Optional cost centre for payroll cost allocation. Plain scalar id.
  costCentreId   String?

  salaryAnnualGross            Decimal @db.Decimal(15, 2)
  salaryCurrency                String       @default("ZAR")
  salaryPayFrequency             PayFrequency @default(monthly)
  // Wage basis for variable pay (Phase 4). "salaried" is the default and keeps
  // the salaried monthly calculation byte-for-byte unchanged. Wage-based types
  // ("hourly" | "daily" | "weekly") drive the per-run capture helpers only;
  // rates below are consumed upstream to compute component amounts.
  wageType                     String       @default("salaried")
  hourlyRate                   Decimal? @db.Decimal(15, 2)
  dailyRate                    Decimal? @db.Decimal(15, 2)
  weeklyRate                   Decimal? @db.Decimal(15, 2)
  // Ordinary hours per month for hourly staff. When unset, 173.33 is used.
  ordinaryHoursPerMonth        Decimal? @db.Decimal(15, 2)
  salaryTravelAllowance           Decimal? @db.Decimal(15, 2)
  salaryHousingAllowance           Decimal? @db.Decimal(15, 2)
  salaryPensionContributionPct     Float?
  salaryMedicalAid                  Decimal? @db.Decimal(15, 2)
  salaryRetirementAnnuity          Decimal? @db.Decimal(15, 2)
  /// JSON array of { label: string, amount: number, taxable: boolean }.
  salaryEmployerBenefits           Json?

  bankName              String
  bankAccountNumber     String
  bankBranchCode        String
  bankAccountType       String
  bankAccountValidated  Boolean   @default(false)
  bankValidatedAt       DateTime?

  taxNumber String
  idNumber  String
  address   String

  // Identity document. idType selects which set of fields applies:
  // "sa_id" uses idNumber; "passport" uses passportNumber + nationality and
  // requires an explicit dateOfBirth (there is no ID to derive it from).
  idType         String    @default("sa_id")
  passportNumber String?
  nationality    String?
  dateOfBirth    DateTime?
  // First-class demographics, independent of the employment-equity capture.
  gender         String?
  maritalStatus  String?

  emergencyContactName         String
  emergencyContactRelationship String
  emergencyContactPhone        String

  // Next of kin. Distinct from the emergency contact, though the two are often
  // the same person: emergencyContactSameAsNextOfKin records that choice so the
  // edit view can restore it. When true, the emergencyContact* fields are
  // written with the next-of-kin values on save.
  nextOfKinName                   String?
  nextOfKinRelationship           String?
  nextOfKinPhone                  String?
  nextOfKinAddress                String?
  emergencyContactSameAsNextOfKin Boolean @default(false)

  // Repeatable skills and languages captured on the profile.
  skills    String[] @default([])
  languages String[] @default([])

  // Employment Equity (EEA2/EEA4) demographics
  equityRace        EquityRace?
  equityGender      EquityGender?
  occupationalLevel OccupationalLevel?
  foreignNational   Boolean            @default(false)
  hasDisability     Boolean            @default(false)

  onboarding Json?

  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  payslips      Payslip[]
  user          User?

  // Payroll compliance relations
  payrollProfile PayrollProfile?
  salaryHistory  EmployeeSalaryHistory[]
  payrollItems   PayrollItem[]
  payrollInputs  PayrollInput[]
  documents      EmployeeDocument[]
  deductions     EmployeeDeduction[]
  etiClaims      EtiClaim[]
  qualifications EmployeeQualification[]
  customFieldValues EmployeeCustomFieldValue[]
  disciplinaryRecords DisciplinaryRecord[]
  performanceReviews  PerformanceReview[]
  historyEvents       EmployeeHistoryEvent[]

  // Termination. terminatedAt is set when employment ends; it drives the
  // termination letter template and leave encashment calculation.
  terminatedAt       DateTime?
  terminationReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, employeeNumber])
  @@index([tenantId])
}

// A single qualification, skill certificate or licence held by an employee.
// Repeatable: an employee can have many. Additive; no existing data depends on it.
model EmployeeQualification {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // degree | diploma | certificate | licence
  type          String
  name          String
  institution   String?
  yearCompleted Int?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([tenantId])
  @@index([employeeId])
}

// Tenant-defined custom field. HR configures the label, type and (for selects)
// the option list. Renders as an "Additional information" card on every
// employee. Zero definitions means nothing extra is shown.
model TenantCustomFieldDefinition {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label     String
  // text | number | date | select
  fieldType String   @default("text")
  /// JSON array of string options, only used when fieldType is "select".
  options   Json?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  values EmployeeCustomFieldValue[]

  @@index([tenantId])
}

// One employee's value for one custom-field definition.
model EmployeeCustomFieldValue {
  id           String                      @id @default(cuid())
  tenantId     String
  tenant       Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee                    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  definitionId String
  definition   TenantCustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  value        String

  @@unique([employeeId, definitionId])
  @@index([tenantId])
  @@index([employeeId])
}

model LeaveBalance {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       LeaveType
  total      Float
  used       Float     @default(0)

  @@unique([employeeId, type])
}

model LeaveRequest {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type          LeaveType
  startDate     DateTime
  endDate       DateTime
  days          Float
  /// JSON array of { date: string (ISO), type: "full" | "partial" }.
  /// Null for requests created before the day-picker feature.
  daySelections Json?
  reason        String
  documentUrl   String?
  status        LeaveStatus @default(pending)
  appliedOn     DateTime    @default(now())
  decisionNote  String?
  decidedBy     String?
  decidedOn     DateTime?
  cancelledBy   String?
  cancelledOn   DateTime?

  @@index([tenantId])
  @@index([employeeId])
}

model Department {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String
  headId      String?
  color       String
  budget      Decimal @db.Decimal(15, 2)

  @@index([tenantId])
}

// Canonical job-position catalogue (title + optional grade/band). Used to
// standardise the free-text job title at capture. Additive.
model JobPosition {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title     String
  grade     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// Cost centre for allocating payroll cost. Optionally assigned per employee.
// Additive.
model CostCentre {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model PayrollRun {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period          String
  label           String
  payDate         DateTime
  status          PayrollRunStatus @default(scheduled)
  // Optional branch this run targets. Null means the run covers the whole
  // company (current behaviour: all non-terminated, started employees).
  branchId        String?
  // Run classification. "regular" is the normal monthly scheduled run (the only
  // behaviour before Phase 6); "off_cycle" is an ad-hoc run outside the schedule
  // (a bonus run or a correction) that finalises independently. Null is treated
  // as "regular" so every existing run keeps its behaviour.
  runType         String?          @default("regular")
  // Optional free-text reason for an off-cycle run (e.g. "Q3 bonus", "March
  // correction"). Null for regular runs.
  runReason       String?
  totalGross      Decimal @db.Decimal(15, 2)            @default(0)
  totalDeductions Decimal @db.Decimal(15, 2)            @default(0)
  totalNet        Decimal @db.Decimal(15, 2)            @default(0)
  totalPaye       Decimal @db.Decimal(15, 2)            @default(0)
  totalUif        Decimal @db.Decimal(15, 2)            @default(0)
  employeeCount   Int              @default(0)
  processedOn     DateTime?

  payslips     Payslip[]
  bankExports  BankExport[]
  payrollInputs PayrollInput[]
  approvedBy   String?
  approvedAt   DateTime?
  approvalNote String?

  // Explicit lock on a completed run. When lockedAt is set the run cannot be
  // cancelled/reversed until it is unlocked, giving HR a deliberate control over
  // finalised payroll separate from the soft "completed" status.
  lockedAt     DateTime?
  lockedBy     String?

  @@index([tenantId])
}

model Payslip {
  id              String     @id @default(cuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runId           String
  run             PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period          String
  payDate         DateTime
  basicSalary     Decimal @db.Decimal(15, 2)
  earnings        Json
  deductions      Json
  grossPay        Decimal @db.Decimal(15, 2)
  totalDeductions Decimal @db.Decimal(15, 2)
  netPay          Decimal @db.Decimal(15, 2)
  paye            Decimal @db.Decimal(15, 2)
  uif             Decimal @db.Decimal(15, 2)
  employerUif     Decimal? @db.Decimal(15, 2)
  employerSdl     Decimal? @db.Decimal(15, 2)
  /// Snapshot JSON array of { label, amount, taxable } at run time.
  employerBenefits Json?
  /// Snapshot JSON array of { label, balance } of outstanding loan/garnishee balances.
  closingBalances Json?
  /// PAYE basis for transparency: annual taxable income and annual rebate applied.
  taxableIncomeAnnual Decimal? @db.Decimal(15, 2)
  taxRebateAnnual     Decimal? @db.Decimal(15, 2)
  payrollItems    PayrollItem[]

  @@index([tenantId])
  @@index([employeeId])
}

model ActivityItem {
  id         String       @id @default(cuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type       ActivityType
  message    String
  actor      String
  employeeId String?
  timestamp  DateTime     @default(now())

  @@index([tenantId])
}

model NotificationItem {
  id                  String           @id @default(cuid())
  tenantId            String
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title               String
  description         String
  timestamp           DateTime         @default(now())
  read                Boolean          @default(false)
  type                NotificationType
  // Audience scoping. Only one of these should be set per notification.
  // audienceRole: "hr" = hr+exco only; "manager" = hr+exco+manager; null = broadcast (use sparingly)
  // recipientEmployeeId: personal notification for exactly one employee (takes precedence)
  audienceRole        String?
  recipientEmployeeId String?

  @@index([tenantId])
  @@index([tenantId, recipientEmployeeId])
}

// ============================================================
// PAYROLL COMPLIANCE MODELS
// ============================================================

model PayrollProfile {
  id                   String               @id @default(cuid())
  tenantId             String
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId           String               @unique
  employee             Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  status               PayrollProfileStatus @default(active)
  taxNumber            String?
  uifNumber            String?
  taxDirective         String?
  taxDirectiveAmount   Decimal? @db.Decimal(15, 2)
  payFrequency         PayFrequency         @default(monthly)
  effectiveDate        DateTime             @default(now())
  medicalAidScheme     String?
  medicalAidNumber     String?
  medicalAidDependants Int                  @default(0)
  retirementFundName   String?
  retirementFundNumber String?
  notes                String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([tenantId])
}

model EarningType {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  category    EarningCategory
  isTaxable   Boolean         @default(true)
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([tenantId])
}

model DeductionType {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  category    DeductionCategory
  isEmployer  Boolean           @default(false)
  isStatutory Boolean           @default(false)
  isActive    Boolean           @default(true)
  sortOrder   Int               @default(0)
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([tenantId])
}

model ComplianceRecord {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period      String
  type        ComplianceType
  status      ComplianceStatus @default(pending)
  totalPaye   Decimal @db.Decimal(15, 2)            @default(0)
  totalUif    Decimal @db.Decimal(15, 2)            @default(0)
  totalSdl    Decimal @db.Decimal(15, 2)            @default(0)
  totalEti    Decimal @db.Decimal(15, 2)            @default(0)
  etiCarriedForward Decimal @db.Decimal(15, 2)       @default(0)
  totalAmount Decimal @db.Decimal(15, 2)            @default(0)
  dueDate     DateTime?
  submittedOn DateTime?
  reference   String?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([tenantId, period, type])
  @@index([tenantId])
}

/// CAUTION: a raw-SQL partial unique index (BankExport_active_nif_per_run_key,
/// one active nif export per payroll run) exists in 20260709120000_baseline_v1
/// but cannot be expressed here. Do not let `migrate dev` drop it.
model BankExport {
  id           String           @id @default(cuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollRunId String
  payrollRun   PayrollRun       @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  status       BankExportStatus @default(pending)
  totalAmount  Decimal @db.Decimal(15, 2)
  paymentCount Int
  bankName     String?
  fileFormat   String           @default("csv")
  exportedAt   DateTime?
  approvedBy   String?
  approvedAt   DateTime?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([tenantId])
}

model PayrollSettings {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taxYearStart       String   @default("03")
  taxYearEnd         String   @default("02")
  sdlEnabled         Boolean  @default(true)
  sdlRate            Float    @default(0.01)
  uifEnabled         Boolean  @default(true)
  uifEmployeeRate    Float    @default(0.01)
  uifEmployerRate    Float    @default(0.01)
  uifCeiling         Decimal @db.Decimal(15, 2)    @default(17712)
  offersPension      Boolean  @default(false)
  offersMedicalAid   Boolean  @default(false)
  payrollConfiguredAt DateTime?
  payslipCompanyName String?
  payslipLogoUrl     String?
  payslipAccentColor String          @default("#6366f1")
  payslipTemplate    PayslipTemplate @default(classic)
  payslipLogoAlignment PayslipLogoAlignment @default(left)
  payslipFooterNote  String?
  payslipShowBanking Boolean         @default(false)
  payslipShowYtd     Boolean         @default(true)
  requireApproval      Boolean  @default(false)
  approvalUserId       String?
  netcashSalaryKey          String?
  netcashAccountServicesKey String?
  netcashInstruction        String   @default("DatedSalaries")
  netcashEnvironment        String   @default("production")
  payeReferenceNumber  String?
  uifReferenceNumber   String?
  sdlReferenceNumber   String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model PayrollItem {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payslipId   String
  payslip     Payslip  @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  itemType    String
  category    String
  label       String
  isStatutory Boolean  @default(false)
  isEmployer  Boolean  @default(false)
  amount      Decimal @db.Decimal(15, 2)
  ytdAmount   Decimal @db.Decimal(15, 2)    @default(0)
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([payslipId])
  @@index([employeeId])
}

// Variable pay captured against an open payroll run (Phase 4). Each row is one
// component for one employee: overtime, commission, an allowance, a bonus, and
// so on. componentType drives IRP5 mapping and multiplier semantics; amount is
// always the final rand value the calculator consumes. taxTreatment decides
// whether the amount annualises like regular income ("regular") or is taxed via
// the SARS non-recurring delta method ("annual_payment").
model PayrollInput {
  id            String     @id @default(cuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollRunId  String
  payrollRun    PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  componentType String
  label         String
  quantity      Decimal? @db.Decimal(15, 2)
  rate          Decimal? @db.Decimal(15, 2)
  amount        Decimal @db.Decimal(15, 2)
  taxTreatment  String     @default("regular")
  createdAt     DateTime   @default(now())

  @@index([tenantId])
  @@index([payrollRunId])
}

model Invite {
  id         String       @id @default(cuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email      String
  name       String
  role       UserRole     @default(employee)
  employeeId String?
  // SHA-256 hash of the invite token. The raw token only ever appears in the
  // invite email link and is never stored.
  tokenHash  String       @unique
  status     InviteStatus @default(pending)
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime     @default(now())

  @@unique([tenantId, email])
  @@index([tenantId])
}

model EmployeeSalaryHistory {
  id                String       @id @default(cuid())
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  annualGross       Decimal @db.Decimal(15, 2)
  payFrequency      PayFrequency
  travelAllowance   Decimal? @db.Decimal(15, 2)
  housingAllowance  Decimal? @db.Decimal(15, 2)
  medicalAid        Decimal? @db.Decimal(15, 2)
  pensionContribPct Float?
  retirementAnnuity Decimal? @db.Decimal(15, 2)
  effectiveDate     DateTime
  changedBy         String
  changeReason      String?
  createdAt         DateTime     @default(now())

  @@index([tenantId])
  @@index([employeeId])
}

model EmployeeNumberConfig {
  id         String   @id @default(cuid())
  tenantId   String   @unique
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prefix     String   @default("EMP")
  padLength  Int      @default(4)
  separator  String   @default("-")
  nextNumber Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum LeaveAccrualMethod {
  upfront
  accrual
}

model TenantLeavePolicy {
  id                      String   @id @default(cuid())
  tenantId                String   @unique
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  annualDays              Float    @default(15)
  // How annual leave is made available: earned monthly over 12 months (accrual,
  // the default) or the full entitlement upfront.
  leaveAccrualMethod      LeaveAccrualMethod @default(accrual)
  sickDays                Float    @default(30)
  familyDays              Float    @default(3)
  maternityDays           Float    @default(88)
  parentalDays            Float    @default(10)
  adoptionDays            Float    @default(50)
  commissioningDays       Float    @default(50)
  studyDays               Float    @default(5)
  unpaidDays              Float    @default(5)
  annualCarryover         Boolean  @default(false)
  annualMaxCarryoverDays  Float    @default(5)
  sickRequireDocDays      Int      @default(2)
  // Whether the employer pays the employee during statutory family leave. The
  // BCEA does not require this (the employee claims from the UIF), so these
  // default to false; a company that offers paid family leave sets them true.
  maternityPaid           Boolean  @default(false)
  parentalPaid            Boolean  @default(false)
  adoptionPaid            Boolean  @default(false)
  commissioningPaid       Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

enum EmployeeDocumentCategory {
  contract
  id_document
  qualification
  certificate
  disciplinary
  medical
  other
}

model EmployeeDocument {
  id          String                   @id @default(cuid())
  tenantId    String
  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name        String
  category    EmployeeDocumentCategory @default(other)
  storagePath String
  fileName    String
  mimeType    String
  sizeBytes   Int                      @default(0)
  expiresAt   DateTime?
  uploadedBy  String?
  // Version history. Re-uploading a document with the same name and category
  // supersedes the prior one: the old row keeps isCurrent = false, the new row
  // increments version and links back via previousVersionId.
  version           Int      @default(1)
  isCurrent         Boolean  @default(true)
  previousVersionId String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([tenantId])
  @@index([employeeId])
}

enum DeductionKind {
  loan
  garnishee
  other
}

enum RecoveryStatus {
  active
  settled
  cancelled
}

model EmployeeDeduction {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind           DeductionKind  @default(loan)
  description    String
  reference      String?
  originalAmount Decimal @db.Decimal(15, 2)
  monthlyAmount  Decimal @db.Decimal(15, 2)
  balance        Decimal @db.Decimal(15, 2)
  status         RecoveryStatus @default(active)
  startDate      DateTime       @default(now())
  settledAt      DateTime?
  createdBy      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([tenantId])
  @@index([employeeId])
}

enum EquityRace {
  african
  coloured
  indian
  white
  other
}

enum EquityGender {
  male
  female
  other
}

enum OccupationalLevel {
  top_management
  senior_management
  professional_mid
  skilled_technical
  semi_skilled
  unskilled
}

model CustomHoliday {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  date      String  // YYYY-MM-DD
  recurring Boolean @default(false)

  @@index([tenantId])
}

// Configures who can approve leave requests, beyond the default HR/manager roles.
// HR admin sets this up; any matching reviewer can approve/reject.
// scope: "all" = whole tenant, "department" = one department, "employee" = one employee.
model LeaveReviewer {
  id                 String  @id @default(cuid())
  tenantId           String
  tenant             Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviewerEmployeeId String  // employee who is authorised to approve leave
  scope              String  @default("all") // "all" | "department" | "employee"
  scopeId            String? // departmentId or employeeId when scope != "all"
  label              String? // optional display label, e.g. "Engineering backup approver"

  @@index([tenantId])
  @@index([tenantId, reviewerEmployeeId])
}

model EtiClaim {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period          String
  qualifyingMonth Int
  amount          Decimal @db.Decimal(15, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([employeeId, period])
  @@index([tenantId])
  @@index([employeeId])
}

/// Shared fixed-window rate-limit counters. Backs the security rate limiter so
/// limits hold across serverless instances instead of per warm instance. Not
/// tenant-scoped: the key namespaces the protected action and identifier (IP,
/// tenant or session), e.g. "login:203.0.113.7".
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
  updatedAt   DateTime @updatedAt
}

// A formal disciplinary or counselling record for an employee (Phase 6).
// Additive: no existing data depends on this model.
model DisciplinaryRecord {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // Type of action: warning_verbal, warning_written, final_warning, suspension,
  // dismissal, counselling.
  type        String
  // Short description of the incident or hearing outcome.
  description String
  // When the warning or action was issued.
  issuedAt    DateTime
  // Optional expiry (e.g. a verbal warning expires after 3 months).
  expiresAt   DateTime?
  // Who raised the record (display name).
  createdBy   String
  // Link to an uploaded document, if any.
  documentId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, employeeId])
}

// A structured change in an employee's employment: a promotion (job title), or
// a transfer (department or branch). Auto-captured when HR edits the employee.
// Additive: no existing data depends on this model.
model EmployeeHistoryEvent {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // promotion | transfer
  type          String
  // Human-readable field that changed, e.g. "Job title", "Department", "Branch".
  field         String
  oldValue      String?
  newValue      String?
  changedBy     String
  effectiveDate DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([employeeId])
}

// A performance review for an employee within a named cycle. Additive: no
// existing data depends on this model.
model PerformanceReview {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // Review cycle label, e.g. "2026 Annual" or "2026 H1".
  cycle          String
  reviewDate     DateTime
  // Overall rating 1 (well below) to 5 (outstanding).
  rating         Int
  strengths      String?
  improvements   String?
  goals          String?
  // Display name of the manager/HR reviewer who authored the review.
  reviewer       String
  // draft | acknowledged. Acknowledged records the employee's sign-off.
  status         String    @default("draft")
  acknowledgedAt DateTime?
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId])
  @@index([employeeId])
}

// A company-wide announcement or policy document (Phase 6).
// Visible to employees via self-service; HR/exco create and manage them.
model Announcement {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  // Markdown body so HR can structure the content.
  body        String
  // audience: "all" = everyone, "managers" = managers and above.
  audience    String   @default("all")
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}
