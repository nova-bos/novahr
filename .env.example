# Copy this file to .env and fill in real values from your Supabase project
# (Project Settings -> Database for the connection strings, Project Settings -> API for the keys).
# .env is gitignored - never commit real credentials. Both Next.js and the
# Prisma CLI (via prisma.config.ts) read this single file.

# Postgres connection used by Prisma Client at runtime.
# Supabase: "Connection pooling" string, port 6543 (Transaction mode / pgbouncer).
DATABASE_URL="postgresql://postgres.xxxxxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct (non-pooled) Postgres connection, used by Prisma Migrate.
# Supabase: "Connection string" -> "Direct connection", port 5432.
DIRECT_URL="postgresql://postgres.xxxxxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres"

# Supabase project URL and anon (public) key - safe to expose to the browser.
# Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase service role key - SERVER-ONLY, never expose to the browser.
# Used by the seed script to create the demo Supabase Auth users.
# Project Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
