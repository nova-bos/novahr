# Copy this file to .env and fill in real values from your Supabase project
# (Project Settings -> Database for the connection strings, Project Settings -> API for the keys).
# .env is gitignored - never commit real credentials. Both Next.js and the
# Prisma CLI (via prisma.config.ts) read this single file.

# Postgres connection used by Prisma Client at runtime.
# Supabase: "Connection pooling" string, port 6543 (Transaction mode / pgbouncer).
DATABASE_URL="postgresql://postgres.xxxxxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct (non-pooled) Postgres connection, used by Prisma Migrate.
# Supabase: "Connection string" -> "Direct connection", port 5432.
DIRECT_URL="postgresql://postgres.xxxxxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres"

# Supabase project URL and anon (public) key - safe to expose to the browser.
# Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase service role key - SERVER-ONLY, never expose to the browser.
# Used by the seed script to create the demo Supabase Auth users.
# Project Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Environment identifier shown in the in-app banner.
# Set to "development" locally, "staging" on Vercel Preview, "production" on Vercel Production.
# Omit or set to "production" to suppress the banner entirely.
NEXT_PUBLIC_APP_ENV="development"

# Resend API key for transactional email notifications.
# Get your key at resend.com/api-keys. Leave blank to disable email sends.
RESEND_API_KEY=""

# The "from" address used for outgoing emails. Must be a verified domain in Resend.
# Example: "NovaHR <no-reply@yourcompany.co.za>"
EMAIL_FROM="NovaHR <no-reply@novabos.co.za>"
# Optional alias also read by some senders; keep in sync with EMAIL_FROM.
RESEND_FROM="NovaHR <no-reply@novabos.co.za>"

# Canonical app URL included in email links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-side key used to encrypt Netcash service keys at rest (AES-256-GCM).
# Must be a 64-character hex string (32 bytes). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If this key is lost, tenants must re-enter their Netcash keys in Settings.
NETCASH_ENCRYPTION_KEY=""

# Netcash API endpoint. Point at the live endpoint in production (not UAT).
NETCASH_UAT_ENDPOINT=""

# Server-side key used to encrypt personal information at rest (AES-256-GCM).
# REQUIRED in production. Must be a 64-character hex string (32 bytes):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it stable and backed up. Rotating or losing it makes existing PII unreadable.
PII_ENCRYPTION_KEY=""

# Paystack secret key for billing (subscriptions, webhooks, transaction verify).
# REQUIRED in production. Use the live key (sk_live_...) once Paystack is approved.
PAYSTACK_SECRET_KEY=""

# Shared secret protecting the scheduled billing cron (/api/cron/billing).
# REQUIRED in production. Vercel sends it as the Authorization bearer token.
CRON_SECRET=""

# Public-facing contact details surfaced in the app UI.
NEXT_PUBLIC_SALES_EMAIL="sales@novabos.co.za"
NEXT_PUBLIC_SUPPORT_EMAIL="support@novabos.co.za"
NEXT_PUBLIC_SUPPORT_WHATSAPP=""
SALES_EMAIL="sales@novabos.co.za"

# Sentry error tracking DSN. Safe to expose to the browser (used by the client bundle).
# Get from sentry.io: Settings -> Projects -> your project -> Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN="https://your-key@oXXX.ingest.us.sentry.io/XXX"

# Optional: set these in Vercel to enable source map uploads (readable stack traces in Sentry).
# SENTRY_ORG="your-org-slug"
# SENTRY_PROJECT="your-project-slug"
